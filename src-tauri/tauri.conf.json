{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LightningTeX",
  "version": "0.1.0",
  "identifier": "top.florance.lightningtex",
  "build": {
    "frontendDist": "../src/dist",
    "devUrl": "http://localhost:4173",
    "beforeDevCommand": "npm run preview",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "LightningTeX",
        "create": false,
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
